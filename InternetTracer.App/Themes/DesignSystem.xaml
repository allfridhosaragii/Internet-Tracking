<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 
        Internet Tracer Design System 
        Strict anti-slop rules: 
        1. Typography: Segoe UI Variable Display for headers, Text for body.
        2. Colors: High-contrast data visualization colors. 
        3. Surfaces: Use LayerFillColorDefaultBrush instead of excessive glass.
    -->

    <!-- Typography Tokens -->
    <FontFamily x:Key="BrandFontFamily">Segoe UI Variable Display, Segoe UI, Arial, sans-serif</FontFamily>
    <FontFamily x:Key="BodyFontFamily">Segoe UI Variable Text, Segoe UI, Arial, sans-serif</FontFamily>

    <!-- Semantic Color Tokens for Telemetry (Dark Theme Optimized) -->
    <SolidColorBrush x:Key="TelemetryDownloadBrush" Color="#4CAF50" /> <!-- Green for DL -->
    <SolidColorBrush x:Key="TelemetryUploadBrush" Color="#2196F3" />   <!-- Blue for UL -->
    <SolidColorBrush x:Key="TelemetryWarningBrush" Color="#FFC107" />  <!-- Amber for Warning/Loss -->
    <SolidColorBrush x:Key="TelemetryErrorBrush" Color="#F44336" />    <!-- Red for Dropped/Failed -->
    <SolidColorBrush x:Key="TelemetryUnattributedBrush" Color="#9E9E9E" /> <!-- Gray for Unattributed -->

    <!-- Surface Hierarchy Tokens -->
    <!-- WinUI 3 Default Layer brushes provide the exact correct Fluent surface colors -->
    <StaticResource x:Key="CardBackgroundBrush" ResourceKey="LayerFillColorDefaultBrush" />
    <StaticResource x:Key="CardBorderBrush" ResourceKey="CardStrokeColorDefaultBrush" />
    <Thickness x:Key="CardBorderThickness">1</Thickness>
    <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
    <Thickness x:Key="CardPadding">20</Thickness>
    <Thickness x:Key="CardMargin">0,0,0,16</Thickness>

    <!-- Text Styles -->
    <Style x:Key="DashboardHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BrandFontFamily}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,24" />
    </Style>

    <Style x:Key="CardTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BrandFontFamily}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="KpiValueStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BrandFontFamily}" />
        <Setter Property="FontSize" Value="36" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="KpiUnitStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Margin" Value="4,0,0,6" />
    </Style>
    
    <!-- Base Card Container Style -->
    <Style x:Key="DashboardCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource CardBorderThickness}" />
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
        <Setter Property="Margin" Value="{StaticResource CardMargin}" />
    </Style>

</ResourceDictionary>
