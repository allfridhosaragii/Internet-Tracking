<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="InternetTracer_App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:InternetTracer_App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Internet Tracer"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="Internet Tracer">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <NavigationView Grid.Row="1" x:Name="NavView" PaneDisplayMode="Auto" IsBackButtonVisible="Collapsed" ItemInvoked="NavView_ItemInvoked">
            <NavigationView.MenuItems>
                <!-- Primary Information Architecture -->
                <NavigationViewItem Icon="Home" Content="Overview" Tag="DashboardPage" />
                <NavigationViewItem Icon="Sync" Content="Traffic" Tag="TrafficPage" />
                <NavigationViewItem Icon="List" Content="Applications" Tag="ApplicationsPage" />
                <NavigationViewItem Icon="Globe" Content="Networks" Tag="NetworksPage" />
                <NavigationViewItem Icon="Clock" Content="Sessions" Tag="SessionsPage" />
                <NavigationViewItem Icon="GoToToday" Content="Analytics" Tag="AnalyticsPage" />
            </NavigationView.MenuItems>
            
            <NavigationView.FooterMenuItems>
                <!-- Supporting Areas -->
                <NavigationViewItem Icon="Important" Content="Alerts" Tag="AlertsPage" />
            </NavigationView.FooterMenuItems>

            <Frame x:Name="RootFrame" />
        </NavigationView>
    </Grid>
</Window>
