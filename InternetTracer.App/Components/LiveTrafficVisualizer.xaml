<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="InternetTracer_App.Components.LiveTrafficVisualizer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    SizeChanged="UserControl_SizeChanged">

    <Grid Height="120">
        <!-- Axes / Gridlines -->
        <Line x:Name="ZeroLine" X1="0" Y1="120" X2="100" Y2="120" Stroke="{ThemeResource SurfaceBorderBrush}" StrokeThickness="1" />
        
        <!-- Max Values text -->
        <TextBlock x:Name="MaxDownloadText" Text="0 MB/s" Style="{StaticResource TypographyCaption}" Foreground="{ThemeResource TelemetryDownloadBrush}" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,4,8,0" />
        <TextBlock x:Name="MaxUploadText" Text="0 MB/s" Style="{StaticResource TypographyCaption}" Foreground="{ThemeResource TelemetryUploadBrush}" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,20,8,0" />

        <Canvas x:Name="ChartCanvas">
            <!-- Upload Graph (drawn first, in background) -->
            <Polygon x:Name="UploadPolygon" Fill="{ThemeResource TelemetryUploadBrush}" Opacity="0.5" />
            <Polyline x:Name="UploadLine" Stroke="{ThemeResource TelemetryUploadBrush}" StrokeThickness="2" />

            <!-- Download Graph (drawn in front) -->
            <Polygon x:Name="DownloadPolygon" Fill="{ThemeResource TelemetryDownloadBrush}" Opacity="0.7" />
            <Polyline x:Name="DownloadLine" Stroke="{ThemeResource TelemetryDownloadBrush}" StrokeThickness="2" />
        </Canvas>
    </Grid>
</UserControl>
