<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="InternetTracer_App.Components.LiveTrafficVisualizer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:InternetTracer_App.Components"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    SizeChanged="UserControl_SizeChanged"
    PointerMoved="OnPointerMoved"
    PointerExited="OnPointerExited">

    <Grid Height="120">
        <!-- Axes / Gridlines -->
        <Line x:Name="ZeroLine" X1="0" Y1="120" X2="100" Y2="120" Stroke="{ThemeResource SurfaceBorderBrush}" StrokeThickness="1" />
        
        <!-- Max Values text -->
        <TextBlock x:Name="MaxDownloadText" Text="0 MB/s" Style="{StaticResource TypographyCaption}" Foreground="{ThemeResource TelemetryDownloadBrush}" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,4,8,0" AutomationProperties.Name="Maximum Download Speed" />
        <TextBlock x:Name="MaxUploadText" Text="0 MB/s" Style="{StaticResource TypographyCaption}" Foreground="{ThemeResource TelemetryUploadBrush}" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,20,8,0" AutomationProperties.Name="Maximum Upload Speed" />

        <Canvas x:Name="ChartCanvas" AutomationProperties.Name="Live Traffic Graph">
            <!-- Polygons (Fill) replaced by Paths -->
            <Path x:Name="DownloadPath" Fill="{ThemeResource TelemetryDownloadBrush}" Opacity="0.2" StrokeThickness="0" />
            <Path x:Name="UploadPath" Fill="{ThemeResource TelemetryUploadBrush}" Opacity="0.2" StrokeThickness="0" />

            <!-- Lines (Stroke) replaced by Paths -->
            <Path x:Name="DownloadLinePath" Stroke="{ThemeResource TelemetryDownloadBrush}" StrokeThickness="2" StrokeLineJoin="Round" />
            <Path x:Name="UploadLinePath" Stroke="{ThemeResource TelemetryUploadBrush}" StrokeThickness="2" StrokeLineJoin="Round" />
            
            <!-- Tooltip Overlay -->
            <Canvas x:Name="TooltipCanvas" IsHitTestVisible="False">
                <Line x:Name="TooltipLine" Y1="0" Y2="0" Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeThickness="1" StrokeDashArray="4,4" Visibility="Collapsed" />
                <Border x:Name="TooltipBox" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="8" Visibility="Collapsed">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="TooltipTimeText" Style="{StaticResource TypographyCaption}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE896;" FontSize="10" Foreground="{ThemeResource TelemetryDownloadBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="TooltipDlText" Style="{StaticResource TypographyCaption}" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE898;" FontSize="10" Foreground="{ThemeResource TelemetryUploadBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="TooltipUlText" Style="{StaticResource TypographyCaption}" FontWeight="SemiBold" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Canvas>
        </Canvas>
    </Grid>
</UserControl>
