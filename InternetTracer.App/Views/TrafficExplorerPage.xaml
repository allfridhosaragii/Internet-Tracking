<UserControl
    x:Class="InternetTracer_App.Views.TrafficExplorerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:InternetTracer_App.ViewModels"
    xmlns:c="using:InternetTracer_App.Components"
    xmlns:v="using:InternetTracer_App.Views"
    xmlns:converters="using:InternetTracer_App.Converters">
    <UserControl.Resources>
        <converters:FirstLetterConverter x:Key="FirstLetterConverter" />
    </UserControl.Resources>
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <!-- Header Section -->
        <StackPanel Margin="24, 16, 24, 0">
            <TextBlock Text="Traffic Explorer"
                       FontSize="32"
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource TextFillColorPrimary}" />
            
            <TextBlock x:Name="LastUpdatedText"
                       Text="updated just now"
                       FontSize="14"
                       Foreground="{ThemeResource TextFillColorTertiary}"
                       Margin="0, 4, 0, 16" />
        </StackPanel>

        <!-- Time Range Selector -->
        <Border Margin="24, 0, 24, 16" Padding="16, 12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="8">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,0,0,12">
                    <TextBlock Text="Filters:" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                    
                    <!-- Application Filter Dropdown -->
                    <ComboBox ItemsSource="{Binding UniqueApplicationIds}" 
                              SelectedItem="{Binding SelectedFilterApplicationId, Mode=TwoWay}"
                              PlaceholderText="All Applications"
                              Width="200">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="Padding" Value="12,6" />
                            </Style>
                        </ComboBox.ItemContainerStyle>
                    </ComboBox>
                    
                    <!-- Network Filter Dropdown -->
                    <ComboBox ItemsSource="{Binding UniqueNetworkIds}" 
                              SelectedItem="{Binding SelectedFilterNetworkId, Mode=TwoWay}"
                              PlaceholderText="All Networks"
                              Width="200" />
                    
                    <!-- Sort Control -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="4">
                        <TextBlock Text="Sort by: " FontSize="14" VerticalAlignment="Center" />
                        <ComboBox ItemsSource="{Binding AvailableSortFields}"
                                  SelectedItem="{Binding SortBy, Mode=TwoWay}"
                                  Width="150" />
                        <Button Command="{Binding ToggleSortDirectionCommand}"
                                Width="40"
                                Height="28"
                                ToolTipService.ToolTip="Toggle sort direction">
                            <FontIcon Glyph="{Binding SortDirectionGlyph}" />
                        </Button>
                    </StackPanel>
                    
                    <!-- Search Box (aligned right) -->
                    <TextBox PlaceholderText="Search applications..."
                             Text="{Binding SearchText, Mode=TwoWay}"
                             Width="200"
                             Margin="20,0,0,0"
                             VerticalContentAlignment="Center" />
                    
                    <!-- Clear Filters Button -->
                    <Button Content="Clear All"
                            Command="{Binding ClearFiltersCommand}"
                            Style="{StaticResource AccentButtonStyle}"
                            Margin="12,0,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Main Content Grid -->
        <Grid Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Applications List -->
            <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <Grid>
                    <!-- Search Box -->
                    <Border Height="48" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="4" Margin="16,16,16,0">
                        <TextBox PlaceholderText="Search applications..."
                                 Text="{Binding SearchText, Mode=TwoWay}"
                                 BorderThickness="0"
                                 Background="Transparent" />
                    </Border>

                    <!-- Applications List -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="16,64,16,16">
                        <ItemsRepeater ItemsSource="{Binding ApplicationList}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="8" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="Transparent" CornerRadius="6" Padding="12">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- App Icon Placeholder -->
                                            <Border Width="32" Height="32" CornerRadius="4" Background="#E5E7EB" Grid.RowSpan="3" Grid.Column="0">
                                                <TextBlock Text="{Binding DisplayName, Converter={StaticResource FirstLetterConverter}}" 
                                                           HorizontalAlignment="Center" 
                                                           VerticalAlignment="Center"
                                                           FontSize="16"
                                                           FontWeight="Bold" />
                                            </Border>

                                            <!-- App Name -->
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="{ThemeResource TextFillColorPrimary}"
                                                       Grid.Row="0"
                                                       Grid.Column="1"
                                                       MaxLines="1"
                                                       Margin="12,0,0,4" />

                                            <!-- Attribution State -->
                                            <TextBlock Text="{Binding AttributionState}"
                                                       FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorTertiary}"
                                                       Grid.Row="1"
                                                       Grid.Column="1"
                                                       Margin="12,0,0,0" />

                                            <!-- Download Bytes (Right Aligned) -->
                                            <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock Text="↓ " FontSize="12" Foreground="{ThemeResource TextFillColorTertiary}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding DownloadBytes}" 
                                                           FontSize="12"
                                                           Foreground="#EF4444"
                                                           VerticalAlignment="Center"
                                                           Margin="4,0,0,0" />
                                            </StackPanel>

                                            <!-- Upload Bytes (Right Aligned) -->
                                            <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock Text="↑ " FontSize="12" Foreground="{ThemeResource TextFillColorTertiary}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding UploadBytes}"
                                                           FontSize="12"
                                                           Foreground="#10B981"
                                                           VerticalAlignment="Center"
                                                           Margin="4,0,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Detail Panel -->
            <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <StackPanel Grid.Row="0" Margin="16,16,16,0">
                        <TextBlock Text="Application Details"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorPrimary}" />
                        <TextBlock x:Name="AppDetailsHeader"
                                   Text="Select an application to view details"
                                   FontSize="14"
                                   Foreground="{ThemeResource TextFillColorTertiary}"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <!-- Timeline Visualizer -->
                    <Border Grid.Row="1" Margin="16,16,16,0" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8">
                        <Grid>
                            <!-- Using LiveTrafficVisualizer for historical data display -->
                            <c:LiveTrafficVisualizer x:Name="HistoricalTimelineChart"
                                                     Timeline="{Binding TrafficTimeline}"
                                                     Height="200" />
                        </Grid>
                    </Border>

                    <!-- Traffic Summary Footer -->
                    <StackPanel Grid.Row="2" Margin="16,16,16,16">
                        <TextBlock Text="Total Traffic (Last 24 Hours)"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorQuaternary}"
                                   Margin="0,0,0,8" />
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Downloaded" FontSize="12" Foreground="{ThemeResource TextFillColorSecondary}" />
                                <TextBlock Text="{Binding TotalTraffic.DownloadBytes}"
                                           FontSize="20"
                                           FontWeight="Semibold"
                                           Foreground="#EF4444"
                                           Margin="0,2,0,0" />
                            </StackPanel>

                            <Rectangle Grid.Column="1" Width="1" Fill="{ThemeResource DividerLineForegroundBrush}" />

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Uploaded" FontSize="12" Foreground="{ThemeResource TextFillColorSecondary}" />
                                <TextBlock Text="{Binding TotalTraffic.UploadBytes}"
                                           FontSize="20"
                                           FontWeight="Semibold"
                                           Foreground="#10B981"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
