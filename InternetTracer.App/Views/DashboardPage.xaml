<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="InternetTracer_App.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:InternetTracer_App.Converters"
    xmlns:core="using:InternetTracer.Core.Contracts"
    xmlns:components="using:InternetTracer_App.Components"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Resources>
        <converters:ByteFormatValueConverter x:Key="ByteValueConverter" />
        <converters:ByteFormatUnitConverter x:Key="ByteUnitConverter" />
        <converters:ByteVolumeFormatUnitConverter x:Key="ByteVolumeUnitConverter" />
    </Page.Resources>

    <components:DataStateContainer 
        State="{x:Bind ViewModel.DashboardDataState, Mode=OneWay}"
        ErrorMessage="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
        OfflineMessage="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
        HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

        <ScrollViewer>
            <StackPanel Margin="32" Spacing="24">
                
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup>
                        <!-- Wide Layout -->
                        <VisualState x:Name="WideLayout">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="1024" />
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="HeaderGrid.ColumnDefinitions[0].Width" Value="2*" />
                                <Setter Target="HeaderGrid.ColumnDefinitions[1].Width" Value="*" />
                                <Setter Target="HeaderGrid.ColumnDefinitions[2].Width" Value="*" />
                                <Setter Target="UploadCard.(Grid.Column)" Value="2" />
                                <Setter Target="UploadCard.(Grid.Row)" Value="0" />
                                <Setter Target="UploadCard.Margin" Value="16,0,0,0" />
                                <Setter Target="DownloadCard.(Grid.Column)" Value="1" />
                                <Setter Target="DownloadCard.(Grid.Row)" Value="0" />
                                <Setter Target="DownloadCard.Margin" Value="16,0,0,0" />
                                <Setter Target="NetworkCard.(Grid.Column)" Value="0" />
                                <Setter Target="NetworkCard.(Grid.Row)" Value="0" />
                            </VisualState.Setters>
                        </VisualState>
                        <!-- Narrow Layout -->
                        <VisualState x:Name="NarrowLayout">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="0" />
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <!-- Stack vertically -->
                                <Setter Target="HeaderGrid.ColumnDefinitions[0].Width" Value="*" />
                                <Setter Target="HeaderGrid.ColumnDefinitions[1].Width" Value="0" />
                                <Setter Target="HeaderGrid.ColumnDefinitions[2].Width" Value="0" />
                                <Setter Target="DownloadCard.(Grid.Column)" Value="0" />
                                <Setter Target="DownloadCard.(Grid.Row)" Value="1" />
                                <Setter Target="UploadCard.(Grid.Column)" Value="0" />
                                <Setter Target="UploadCard.(Grid.Row)" Value="2" />
                                <Setter Target="DownloadCard.Margin" Value="0,16,0,0" />
                                <Setter Target="UploadCard.Margin" Value="0,16,0,0" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>

                <!-- 1. LIVE STATE HEADER -->
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0" Text="LIVE SYSTEM STATE" Style="{StaticResource TypographyPageTitle}" Margin="0"/>
                    
                    <!-- Freshness Indicator -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                        <Ellipse x:Name="PulseIndicator" Width="8" Height="8" Fill="{ThemeResource TelemetryDownloadBrush}">
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="PulseIndicator" Storyboard.TargetProperty="Opacity" From="1" To="0.2" Duration="0:0:1" AutoReverse="True"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                        <TextBlock Text="{x:Bind ViewModel.LiveIndicatorText, Mode=OneWay}" Style="{StaticResource TypographyCaption}" FontWeight="Bold" />
                        <TextBlock Text="-" Style="{StaticResource TypographyCaption}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.LastUpdatedText, Mode=OneWay}" Style="{StaticResource TypographyCaption}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>

                <Grid x:Name="HeaderGrid">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Header without Card Boundaries -->
                    <Grid x:Name="NetworkCard" Grid.Column="0" Grid.Row="0" Margin="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE704;" FontSize="28" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,16,0" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Home Wi-Fi" Style="{StaticResource TypographySectionTitle}" />
                            <TextBlock Text="Connected" Style="{StaticResource TypographySecondary}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <TextBlock Text="QUALITY" Style="{StaticResource TypographyCaption}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.Quality.Status, Mode=OneWay}" Style="{StaticResource TypographyDataValue}" />
                        </StackPanel>
                    </Grid>
                    
                    <StackPanel x:Name="DownloadCard" Grid.Column="1" Grid.Row="0" Margin="0">
                        <TextBlock Text="DOWNLOAD" Style="{StaticResource TypographyCaption}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0" Spacing="6" VerticalAlignment="Bottom">
                            <TextBlock Text="{x:Bind ViewModel.Snapshot.CurrentDownloadBytesPerSec, Mode=OneWay, Converter={StaticResource ByteValueConverter}}" 
                                       Style="{StaticResource TypographyDisplay}" 
                                       Foreground="{ThemeResource TelemetryDownloadBrush}"/>
                            <TextBlock Text="{x:Bind ViewModel.Snapshot.CurrentDownloadBytesPerSec, Mode=OneWay, Converter={StaticResource ByteUnitConverter}}" 
                                       Style="{StaticResource TypographySecondary}" VerticalAlignment="Bottom" Margin="0,0,0,6" />
                        </StackPanel>
                    </StackPanel>
                    
                    <StackPanel x:Name="UploadCard" Grid.Column="2" Grid.Row="0" Margin="0">
                        <TextBlock Text="UPLOAD" Style="{StaticResource TypographyCaption}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0" Spacing="6" VerticalAlignment="Bottom">
                            <TextBlock Text="{x:Bind ViewModel.Snapshot.CurrentUploadBytesPerSec, Mode=OneWay, Converter={StaticResource ByteValueConverter}}" 
                                       Style="{StaticResource TypographyDisplay}" 
                                       Foreground="{ThemeResource TelemetryUploadBrush}"/>
                            <TextBlock Text="{x:Bind ViewModel.Snapshot.CurrentUploadBytesPerSec, Mode=OneWay, Converter={StaticResource ByteUnitConverter}}" 
                                       Style="{StaticResource TypographySecondary}" VerticalAlignment="Bottom" Margin="0,0,0,6" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- 2. LIVE TRAFFIC -->
                <Border Style="{StaticResource SurfacePrimaryStyle}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="LIVE TRAFFIC" Style="{StaticResource TypographySectionTitle}" />
                            <TextBlock Text="Last 60 seconds" Style="{StaticResource TypographyCaption}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" />
                        </Grid>
                        <!-- Adjust height to make it a prominent graph -->
                        <components:LiveTrafficVisualizer Timeline="{x:Bind ViewModel.Timeline, Mode=OneWay}" Height="180" Margin="0,16,0,0" />
                    </StackPanel>
                </Border>

                <!-- 3. APPLICATION ACTIVITY -->
                <Border Style="{StaticResource SurfacePrimaryStyle}">
                    <StackPanel>
                        <TextBlock Text="APPLICATION ACTIVITY (TOP 5)" Style="{StaticResource TypographySectionTitle}" Margin="0,0,0,16" />
                        
                        <!-- Grid Header -->
                        <Grid Margin="0,0,0,8" Padding="0,0,0,8" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="APPLICATION" Style="{StaticResource TypographyCaption}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="1" Text="DOWNLOAD" Style="{StaticResource TypographyCaption}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="2" Text="UPLOAD" Style="{StaticResource TypographyCaption}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="3" Text="TOTAL (VOL)" Style="{StaticResource TypographyCaption}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="4" Text="STATUS" Style="{StaticResource TypographyCaption}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" />
                        </Grid>

                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.TopApps, Mode=OneWay}">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="core:TopUsageEntry">
                                    <Grid Margin="0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- App Info -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                                            <FontIcon Glyph="&#xE718;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}" Style="{StaticResource TypographyDataValue}" FontWeight="SemiBold" />
                                                <TextBlock Text="{x:Bind ProcessName, Mode=OneWay}" Style="{StaticResource TypographyCaption}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                        
                                        <!-- Download -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE896;" FontSize="10" Foreground="{ThemeResource TelemetryDownloadBrush}" />
                                            <TextBlock Text="{x:Bind DownloadBytes, Converter={StaticResource ByteValueConverter}, Mode=OneWay}" Style="{StaticResource TypographyDataValue}" />
                                            <TextBlock Text="{x:Bind DownloadBytes, Converter={StaticResource ByteVolumeUnitConverter}, Mode=OneWay}" Style="{StaticResource TypographyCaption}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>

                                        <!-- Upload -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE898;" FontSize="10" Foreground="{ThemeResource TelemetryUploadBrush}" />
                                            <TextBlock Text="{x:Bind UploadBytes, Converter={StaticResource ByteValueConverter}, Mode=OneWay}" Style="{StaticResource TypographyDataValue}" />
                                            <TextBlock Text="{x:Bind UploadBytes, Converter={StaticResource ByteVolumeUnitConverter}, Mode=OneWay}" Style="{StaticResource TypographyCaption}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        
                                        <!-- Total -->
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind TotalBytes, Converter={StaticResource ByteValueConverter}, Mode=OneWay}" Style="{StaticResource TypographyDataValue}" />
                                            <TextBlock Text="{x:Bind TotalBytes, Converter={StaticResource ByteVolumeUnitConverter}, Mode=OneWay}" Style="{StaticResource TypographyCaption}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>

                                        <!-- Status -->
                                        <TextBlock Grid.Column="4" Text="{x:Bind AttributionState, Mode=OneWay}" Style="{StaticResource TypographyCaption}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>
                
                <!-- 4. HISTORY / CONTEXT -->
                <Grid x:Name="ContextGrid">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource SurfacePrimaryStyle}" Margin="0,0,16,0">
                        <StackPanel>
                            <TextBlock Text="TODAY's VOLUME" Style="{StaticResource TypographySectionTitle}" Margin="0,0,0,8" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="DOWNLOAD" Style="{StaticResource TypographyCaption}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="{x:Bind ViewModel.Summary.TodayTraffic.DownloadBytes, Mode=OneWay, Converter={StaticResource ByteValueConverter}}" Style="{StaticResource TypographyDataValue}" />
                                        <TextBlock Text="{x:Bind ViewModel.Summary.TodayTraffic.DownloadBytes, Mode=OneWay, Converter={StaticResource ByteVolumeUnitConverter}}" Style="{StaticResource TypographyCaption}" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="UPLOAD" Style="{StaticResource TypographyCaption}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="{x:Bind ViewModel.Summary.TodayTraffic.UploadBytes, Mode=OneWay, Converter={StaticResource ByteValueConverter}}" Style="{StaticResource TypographyDataValue}" />
                                        <TextBlock Text="{x:Bind ViewModel.Summary.TodayTraffic.UploadBytes, Mode=OneWay, Converter={StaticResource ByteVolumeUnitConverter}}" Style="{StaticResource TypographyCaption}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                    
                    <Border x:Name="ActiveConnectionsCard" Grid.Column="1" Style="{StaticResource SurfacePrimaryStyle}" Margin="16,0,0,0">
                        <StackPanel>
                            <TextBlock Text="ACTIVE CONNECTIONS" Style="{StaticResource TypographySectionTitle}" />
                            <TextBlock Text="{x:Bind ViewModel.Snapshot.ActiveConnections, Mode=OneWay}" Style="{StaticResource TypographyMetric}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </components:DataStateContainer>
</Page>
